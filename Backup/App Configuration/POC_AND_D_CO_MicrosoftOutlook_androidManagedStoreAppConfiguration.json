{
     "@odata.type": "#microsoft.graph.androidManagedStoreAppConfiguration",
     "roleScopeTagIds": [
          "Default"
     ],
     "description": "Restricts use of only work/school account within the app. Configures app permissions to prevent user requirement to approve them. Configures Outlook app settings.\n\nhttps://learn.microsoft.com/en-us/intune/intune-service/apps/app-configuration-policies-use-android",
     "displayName": "POC_AND_D_CO_MicrosoftOutlook",
     "packageId": "app:com.microsoft.office.outlook",
     "payloadJson": {
          "kind": "androidenterprise#managedConfiguration",
          "productId": "app:com.microsoft.office.outlook",
          "managedProperty": [
               {
                    "key": "com.microsoft.intune.mam.AllowedAccountUPNs",
                    "valueString": "{{userprincipalname}}"
               },
               {
                    "key": "com.microsoft.outlook.EmailProfile.AccountType",
                    "valueString": "ModernAuth"
               },
               {
                    "key": "com.microsoft.outlook.EmailProfile.EmailUPN",
                    "valueString": "{{userprincipalname}}"
               },
               {
                    "key": "com.microsoft.outlook.EmailProfile.EmailAddress",
                    "valueString": "{{mail}}"
               },
               {
                    "key": "IntuneMAMAllowedAccountsOnly",
                    "valueString": "Enabled"
               },
               {
                    "key": "com.microsoft.outlook.Contacts.LocalSyncEnabled",
                    "valueBool": true
               },
               {
                    "key": "com.microsoft.outlook.Mail.ExternalRecipientsToolTipEnabled",
                    "valueBool": true
               }
          ]
     },
     "appSupportsOemConfig": false,
     "profileApplicability": "androidDeviceOwner",
     "connectedAppsEnabled": false,
     "credentialProviderRoleState": "notConfigured",
     "permissionActions": [
          {
               "permission": "android.permission.POST_NOTIFICATIONS",
               "action": "autoGrant"
          },
          {
               "permission": "android.permission.READ_CALENDAR",
               "action": "autoGrant"
          },
          {
               "permission": "android.permission.WRITE_CALENDAR",
               "action": "autoGrant"
          },
          {
               "permission": "android.permission.READ_CONTACTS",
               "action": "autoGrant"
          },
          {
               "permission": "android.permission.WRITE_CONTACTS",
               "action": "autoGrant"
          }
     ],
     "targetedMobileApps": {
          "appName": "Microsoft Outlook",
          "type": "#microsoft.graph.androidManagedStoreApp"
     },
     "assignments": [
          {
               "target": {
                    "@odata.type": "#microsoft.graph.allDevicesAssignmentTarget",
                    "deviceAndAppManagementAssignmentFilterId": "AND_CO",
                    "deviceAndAppManagementAssignmentFilterType": "include"
               }
          }
     ]
}