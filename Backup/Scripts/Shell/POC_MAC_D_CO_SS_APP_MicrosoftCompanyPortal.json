{
     "executionFrequency": "PT0S",
     "retryCount": 3,
     "blockExecutionNotifications": false,
     "displayName": "POC_MAC_D_CO_SS_APP_MicrosoftCompanyPortal",
     "description": "Can be used to install the latest version of the Company Portal on corporate owned devices.\n\nhttps://github.com/microsoft/shell-intune-samples/tree/master/macOS/Apps/Company%20Portal",
     "scriptContent": "",
     "runAsAccount": "system",
     "fileName": "installCompanyPortal.zsh",
     "roleScopeTagIds": [
          "Default"
     ],
     "assignments": [
          {
               "target": {
                    "@odata.type": "#microsoft.graph.groupAssignmentTarget",
                    "deviceAndAppManagementAssignmentFilterId": null,
                    "deviceAndAppManagementAssignmentFilterType": "none",
                    "groupName": "SG_MDM_D_MAC_CO",
                    "groupType": "DynamicMembership",
                    "membershipRule": "(device.deviceManagementAppId -ne null) and (device.deviceOwnership -eq \"Company\") and (device.deviceOSType -eq \"macmdm\")"
               }
          }
     ]
}