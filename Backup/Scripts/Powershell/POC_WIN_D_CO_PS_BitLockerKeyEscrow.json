{
     "enforceSignatureCheck": false,
     "runAs32Bit": true,
     "displayName": "POC_WIN_D_CO_PS_BitLockerKeyEscrow",
     "description": "Used to capture existing BitLocker recovery keys from devices not encrypted by Microsoft Intune.",
     "scriptContent": "",
     "runAsAccount": "system",
     "fileName": "Invoke-EscrowBitlockerToAAD.ps1",
     "roleScopeTagIds": [
          "Default"
     ],
     "assignments": [
          {
               "target": {
                    "@odata.type": "#microsoft.graph.groupAssignmentTarget",
                    "deviceAndAppManagementAssignmentFilterId": null,
                    "deviceAndAppManagementAssignmentFilterType": "none",
                    "groupName": "SG_MDM_D_WIN_CO",
                    "groupType": "DynamicMembership",
                    "membershipRule": "(device.deviceManagementAppId -ne null) and (device.deviceOwnership -eq \"Company\") and (device.deviceOSType -eq \"Windows\")"
               }
          },
          {
               "target": {
                    "@odata.type": "#microsoft.graph.exclusionGroupAssignmentTarget",
                    "deviceAndAppManagementAssignmentFilterId": null,
                    "deviceAndAppManagementAssignmentFilterType": "none",
                    "groupName": "SG_MDM_D_WIN_CO_AP",
                    "groupType": "DynamicMembership",
                    "membershipRule": "(device.devicePhysicalIDs -any (_ -contains \"[ZTDID]\"))"
               }
          },
          {
               "target": {
                    "@odata.type": "#microsoft.graph.exclusionGroupAssignmentTarget",
                    "deviceAndAppManagementAssignmentFilterId": null,
                    "deviceAndAppManagementAssignmentFilterType": "none",
                    "groupName": "SG_MDM_D_CPC_CO",
                    "groupType": "DynamicMembership",
                    "membershipRule": "(device.deviceOwnership -eq \"Company\") and (device.deviceModel -startsWith \"Cloud PC\")"
               }
          }
     ]
}